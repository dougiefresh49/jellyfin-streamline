# Rip flow + copy-watchers. All optional; defaults are the historical paths.
LOCAL_LIBRARY=~/Movies/library                 # SSD staging: ready-to-copy/, staging/, .ripper-*/ state
RIPPER_MEDIA_ROOT=/Volumes/Seagate 4TB/media    # shipped library (also read by scripts/ripper/config.mjs)
VOICE_LAB=~/Movies/library/voice-lab            # where copy-watchers drop center.flac and queue Demucs (same name in the voice-lab repo)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
